# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/

# Data, embeddings, checkpoints, predictions, logs (Large artifacts)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/embeddings/*
!data/embeddings/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
predictions/*
!predictions/.gitkeep
results/*
!results/.gitkeep
logs/*
!logs/.gitkeep

# PyTest / IDE
.pytest_cache/
.coverage
htmlcov/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Smoke-run artifacts
data/smoke/

# Keep small, human-readable results under version control
!results/REPORT.md
!results/experiment_table.md
!results/experiment_table.json
!results/embedding_benchmark.json
!results/*/
results/*/*
!results/*/*_train_summary.json
!results/*/*_learning_curve.png
!results/*/eval_*.json
